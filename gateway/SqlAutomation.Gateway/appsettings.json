{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "connections": {
        "ClusterId": "connections",
        "Match": {
          "Path": "/api/connections/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/connections"
          }
        ]
      }
    },
    "Clusters": {
      "connections": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5090/"
          }
        }
      }
    }
  }
}
